<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone spike project. Deliberately NOT referenced by src/Zilux2/Zilux2.csproj
    and not part of any .sln (this repo has none), so nothing ships from here.
    Its only job is to answer: can ONNX Runtime CPU run HTDemucs on this machine,
    how long does a 30 s window take, and what is the peak memory?
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StemsProto</AssemblyName>
    <RootNamespace>StemsProto</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Run from anywhere; the model path is passed on the command line. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

</Project>
