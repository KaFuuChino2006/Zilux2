    <Compile Include="..\..\..\src\Zilux2\AirPlay\Audio\*.cs" />
    <Compile Include="..\..\..\src\Zilux2\AirPlay\Ap2\*.cs" />
    <Compile Include="..\..\..\src\Zilux2\AirPlay\Crypto\*.cs" />
