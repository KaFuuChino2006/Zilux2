<Project>

  <!--
    Single source of truth for the app version.
    The version is stamped into the host exe, the installer exe, the release tag and the
    update check, so it must only ever live here (or be overridden on the command line).

      local build : 1.1.0
      release CI  : dotnet publish ... -p:Version=<tag> -p:ZiluxUpdateRepo=<owner>/<repo>
  -->
  <PropertyGroup>
    <Version>1.1.7</Version>

    <!-- GitHub repository (owner/name) used by the built-in update channel.
         Local builds default to the real repo below; CI overrides it with
         -p:ZiluxUpdateRepo=${{ github.repository }}. Empty disables the channel. -->
    <ZiluxUpdateRepo Condition="'$(ZiluxUpdateRepo)' == ''">KaFuuChino2006/Zilux2</ZiluxUpdateRepo>
  </PropertyGroup>

  <!-- Baked into the assembly so the host can report the repo without a config file. -->
  <ItemGroup Condition="'$(ZiluxUpdateRepo)' != ''">
    <AssemblyMetadata Include="ZiluxUpdateRepo" Value="$(ZiluxUpdateRepo)" />
  </ItemGroup>

</Project>
