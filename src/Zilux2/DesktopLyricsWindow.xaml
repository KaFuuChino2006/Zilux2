<Window x:Class="Zilux2.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zilux2 桌面歌词"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="980"
        Height="150"
        WindowStartupLocation="Manual">
    <Border x:Name="Shell"
            Background="#5C000000"
            CornerRadius="20"
            Padding="32,16"
            BorderThickness="1"
            BorderBrush="#1FFFFFFF"
            MouseLeftButtonDown="OnShellMouseDown"
            MouseRightButtonUp="OnShellRightClick">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="NowText"
                       Text="桌面歌词"
                       Foreground="#FFFFFF"
                       FontWeight="SemiBold"
                       FontSize="40"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       LineHeight="1.25"/>
            <TextBlock x:Name="TranslationText"
                       Text=""
                       Foreground="#CCFFFFFF"
                       FontSize="18"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
