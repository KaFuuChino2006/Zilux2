<Window x:Class="Zilux2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Zilux2"
        Width="1600" Height="960"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FFFFFF"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="#FFFFFF">
        <!-- Full-bleed page: WebView2 is a child HWND, so an inset WPF strip would show up as a
             6px theme-colored frame around the whole window. Edge/corner resizing is instead
             handled by a host-injected pointerdown listener in the page (5px edges / 12px
             corners, posting the existing {type:'resize'} message). WindowChrome's 6px border
             still covers the plain-WPF ErrorPanel shown when WebView2 cannot start. -->
        <wv2:WebView2 x:Name="Browser" Margin="0" Visibility="Hidden" />

        <!-- 启动遮罩：窗口一出现就是纯色，等 WebView2 首帧后再淡出，避免黑底或桌面闪一下。
             遮罩里就是启动画面本体（标题/副标题/底部进度条），文案取自 设置 → 启动；
             原来这里只是一块纯色，设置里的「启动动画 / 启动标题 / 启动副标题」完全没生效。 -->
        <Grid x:Name="StartupVeil" Background="#FFFFFF" IsHitTestVisible="False">
            <StackPanel x:Name="SplashStack"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0">
                <TextBlock x:Name="SplashTitleText"
                           Text="ZILUX2"
                           FontSize="46" FontWeight="SemiBold"
                           Foreground="#171A21"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="SplashSubtitleText"
                           Text="新一代创意播放器"
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="#8B8F99"
                           HorizontalAlignment="Center" />
                <Border x:Name="SplashBarTrack"
                        Width="132" Height="3" Margin="0,30,0,0"
                        CornerRadius="2" Background="#E3DFD4"
                        ClipToBounds="True">
                    <Border x:Name="SplashBar"
                            Width="42" Height="3" CornerRadius="2"
                            HorizontalAlignment="Left"
                            Background="#8F7AE8" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Plain WPF fallback (no WebView2 runtime / browser process gone): the user must
             never be left staring at an empty frame, and the host must not crash. -->
        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#F6F7FB">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                <TextBlock x:Name="ErrorTitle"
                           Text="Zilux2"
                           Foreground="#171A21"
                           FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorMessage"
                           Margin="0,18,0,0"
                           Foreground="#5D6470"
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBlock x:Name="ErrorLogHint"
                           Margin="0,26,0,0"
                           Foreground="#9AA1AD"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
