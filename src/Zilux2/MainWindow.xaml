<Window x:Class="Zilux2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Zilux2"
        Width="1600" Height="960"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F3F1EA"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="#F3F1EA">
        <!-- Full-bleed page: WebView2 is a child HWND, so an inset WPF strip would show up as a
             6px theme-colored frame around the whole window. Edge/corner resizing is instead
             handled by a host-injected pointerdown listener in the page (5px edges / 12px
             corners, posting the existing {type:'resize'} message). WindowChrome's 6px border
             still covers the plain-WPF ErrorPanel shown when WebView2 cannot start. -->
        <wv2:WebView2 x:Name="Browser" Margin="0" Visibility="Hidden" />

        <!-- 启动遮罩：窗口一出现就是纯色，等 WebView2 首帧后再淡出，避免黑底或桌面闪一下。 -->
        <Border x:Name="StartupVeil" Background="#F3F1EA" IsHitTestVisible="False" />

        <!-- Plain WPF fallback (no WebView2 runtime / browser process gone): the user must
             never be left staring at an empty frame, and the host must not crash. -->
        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#F6F7FB">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                <TextBlock x:Name="ErrorTitle"
                           Text="Zilux2"
                           Foreground="#171A21"
                           FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorMessage"
                           Margin="0,18,0,0"
                           Foreground="#5D6470"
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBlock x:Name="ErrorLogHint"
                           Margin="0,26,0,0"
                           Foreground="#9AA1AD"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
