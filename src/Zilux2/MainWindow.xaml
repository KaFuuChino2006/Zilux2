<Window x:Class="Zilux2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Zilux2"
        Width="1600" Height="960"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F3F1EA"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="#F3F1EA">
        <!-- The inset equals WindowChrome.ResizeBorderThickness. WebView2 is a child HWND:
             when it reaches the window edge it eats WM_NCHITTEST, and borderless resizing dies.
             Keeping that thin strip WPF-owned is what makes edge/corner resizing work; it is
             a little wider than strictly needed because users kept missing the right/bottom
             edge. It is removed while maximized, where there is nothing to resize anyway. -->
        <wv2:WebView2 x:Name="Browser" Margin="0" />

        <!-- Plain WPF fallback (no WebView2 runtime / browser process gone): the user must
             never be left staring at an empty frame, and the host must not crash. -->
        <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#F6F7FB">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                <TextBlock x:Name="ErrorTitle"
                           Text="Zilux2"
                           Foreground="#171A21"
                           FontSize="30" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorMessage"
                           Margin="0,18,0,0"
                           Foreground="#5D6470"
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <TextBlock x:Name="ErrorLogHint"
                           Margin="0,26,0,0"
                           Foreground="#9AA1AD"
                           FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
