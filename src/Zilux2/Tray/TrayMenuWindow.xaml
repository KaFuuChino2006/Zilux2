<Window x:Class="Zilux2.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Zilux2 托盘菜单"
        Width="286"
        SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Focusable="True">
    <!--
      托盘右键菜单（2026-11-24）：替换系统灰色的 ContextMenuStrip，做成和软件同一套观感 ——
      奶油色磨砂卡片、16 圆角、金色点缀，和系统音频 OSD（#F7F4EC）同一个材质族。

      窗口比卡片大 18px，是给 DropShadowEffect 留的透明边，否则阴影会被窗口边缘裁成方角。
      入场 / 出场 / 打断都作用在 TransformRoot 上（含阴影一起淡入淡出），见 TrayMenuWindow.xaml.cs。
    -->
    <Window.Resources>
        <Style x:Key="Row" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#23252B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1E5CB" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F3E8CF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#E2CDA3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 退出：承认它是危险动作，悬停走赤陶红而不是金色。 -->
        <Style x:Key="DangerRow" TargetType="Button" BasedOn="{StaticResource Row}">
            <Setter Property="Foreground" Value="#B23A32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FAE4E0" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F9DCD7" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#EDC2BA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标统一细线：颜色跟着按钮前景走（悬停/危险态自动换色）。 -->
        <Style x:Key="Glyph" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.25" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="25,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Hairline" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="9,5" />
            <Setter Property="Background" Value="#1B000000" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid x:Name="TransformRoot" RenderTransformOrigin="1,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.97" ScaleY="0.97" />
                    <TranslateTransform x:Name="CardShift" Y="10" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="Card"
                    CornerRadius="16"
                    Background="#F9F6EF"
                    BorderBrush="#22000000"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="5"
                                      Direction="270"
                                      Opacity="0.18"
                                      Color="#000000" />
                </Border.Effect>

                <StackPanel Margin="8">
                    <!-- 品牌头：金色小圆点 + ZILUX2 字样，和播放条上的品牌标记同语言。 -->
                    <Grid Height="24" Margin="8,2,8,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#C2A155" VerticalAlignment="Center" />
                            <TextBlock Text="ZILUX2"
                                       Margin="7,0,0,0"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#A8853F"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="HeaderHint"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="9.5"
                                   Foreground="#9AA0A8"
                                   Text="后台运行" />
                    </Grid>

                    <Border Style="{StaticResource Hairline}" Margin="7,0,7,5" />

                    <Button x:Name="ShowRow" Style="{StaticResource Row}" Click="OnShowMain">
                        <Grid>
                            <Path Style="{StaticResource Glyph}"
                                  Data="M2,3.4 H12 A1.1,1.1 0 0 1 13.1,4.5 V10.5 A1.1,1.1 0 0 1 12,11.6 H2 A1.1,1.1 0 0 1 0.9,10.5 V4.5 A1.1,1.1 0 0 1 2,3.4 Z M0.9,6.4 H13.1" />
                            <TextBlock Style="{StaticResource Label}" Text="显示主窗口" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource Hairline}" />

                    <Button x:Name="PlayRow" Style="{StaticResource Row}" Click="OnTogglePlay">
                        <Grid>
                            <Grid>
                                <Path x:Name="PlayGlyph" Style="{StaticResource Glyph}" Data="M4.2,3.2 L11.2,7 L4.2,10.8 Z" />
                                <Path x:Name="PauseGlyph" Style="{StaticResource Glyph}" Visibility="Collapsed" Data="M5,3.6 V10.4 M9,3.6 V10.4" />
                            </Grid>
                            <TextBlock x:Name="PlayLabel" Style="{StaticResource Label}" Text="暂停" />
                        </Grid>
                    </Button>

                    <Button x:Name="PrevRow" Style="{StaticResource Row}" Click="OnPrevious">
                        <Grid>
                            <Path Style="{StaticResource Glyph}" Data="M3.4,3.4 V10.6 M10.8,3.6 L4.6,7 L10.8,10.4 Z" />
                            <TextBlock Style="{StaticResource Label}" Text="上一首" />
                        </Grid>
                    </Button>

                    <Button x:Name="NextRow" Style="{StaticResource Row}" Click="OnNext">
                        <Grid>
                            <Path Style="{StaticResource Glyph}" Data="M10.6,3.4 V10.6 M4.2,3.6 L10.4,7 L4.2,10.4 Z" />
                            <TextBlock Style="{StaticResource Label}" Text="下一首" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource Hairline}" />

                    <!-- 当前壁纸：信息行，不可点，名字过长按行尾省略。 -->
                    <Border Height="28" Padding="9,0" Margin="0,1">
                        <Grid>
                            <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Stroke="#9AA0A8" StrokeThickness="1.25" StrokeLineJoin="Round"
                                  Data="M1.6,2.9 H12.4 A1,1 0 0 1 13.4,3.9 V10.1 A1,1 0 0 1 12.4,11.1 H1.6 A1,1 0 0 1 0.6,10.1 V3.9 A1,1 0 0 1 1.6,2.9 Z M1,9.2 L4.6,5.4 L7.4,8.3 L9.3,6.4 L13,10.2" />
                            <TextBlock x:Name="WallpaperText"
                                       Margin="23,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="#7D838C"
                                       TextTrimming="CharacterEllipsis"
                                       Text="壁纸：未启用" />
                        </Grid>
                    </Border>

                    <Button x:Name="PauseWallpaperRow" Style="{StaticResource Row}" Click="OnToggleWallpaperPause">
                        <Grid>
                            <Path x:Name="WallpaperPauseGlyph" Style="{StaticResource Glyph}" Data="M4.8,3.6 V10.4 M9.2,3.6 V10.4" />
                            <TextBlock x:Name="PauseWallpaperLabel" Style="{StaticResource Label}" Text="暂停壁纸" />
                        </Grid>
                    </Button>

                    <Button x:Name="NextWallpaperRow" Style="{StaticResource Row}" Click="OnNextWallpaper">
                        <Grid>
                            <Path Style="{StaticResource Glyph}" Data="M2.4,7 H10.4 M7.2,3.8 L10.6,7 L7.2,10.2" />
                            <TextBlock Style="{StaticResource Label}" Text="下一张壁纸" />
                        </Grid>
                    </Button>

                    <Button x:Name="DesktopLayerRow" Style="{StaticResource Row}" IsEnabled="False">
                        <Grid>
                            <Path Style="{StaticResource Glyph}" Data="M7,2.2 L12.6,5.2 L7,8.2 L1.4,5.2 Z M1.4,8 L7,11 L12.6,8" />
                            <TextBlock Style="{StaticResource Label}" Text="桌面层（二期）" />
                            <TextBlock Text="即将开放"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="9.5"
                                       Foreground="#9AA0A8" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource Hairline}" />

                    <Button x:Name="UnlockLyricsRow" Style="{StaticResource Row}" Click="OnUnlockLyrics">
                        <Grid>
                            <Path Style="{StaticResource Glyph}"
                                  Data="M4.6,6.8 V5.2 A2.4,2.4 0 0 1 9.4,5.2 V6.2 M3.4,6.8 H10.6 A0.8,0.8 0 0 1 11.4,7.6 V11.2 A0.8,0.8 0 0 1 10.6,12 H3.4 A0.8,0.8 0 0 1 2.6,11.2 V7.6 A0.8,0.8 0 0 1 3.4,6.8 Z" />
                            <TextBlock Style="{StaticResource Label}" Text="解锁桌面歌词" />
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsRow" Style="{StaticResource Row}" Click="OnOpenSettings">
                        <Grid>
                            <Path Style="{StaticResource Glyph}"
                                  Data="M7,4.7 A2.3,2.3 0 1 1 6.99,4.7 Z M7,1.3 V2.6 M7,11.4 V12.7 M1.3,7 H2.6 M11.4,7 H12.7 M3,3 L4,4 M10,10 L11,11 M11,3 L10,4 M4,10 L3,11" />
                            <TextBlock Style="{StaticResource Label}" Text="设置…" />
                        </Grid>
                    </Button>

                    <Border Style="{StaticResource Hairline}" />

                    <Button x:Name="ExitRow" Style="{StaticResource DangerRow}" Click="OnExit">
                        <Grid>
                            <Path Style="{StaticResource Glyph}" Data="M7,2.2 V6.9 M4,4.2 A4.2,4.2 0 1 0 10,4.2" />
                            <TextBlock Style="{StaticResource Label}" Text="退出 Zilux2" />
                        </Grid>
                    </Button>

                    <TextBlock Text="左键单击托盘图标：显示 / 隐藏窗口"
                               Margin="9,4,9,2"
                               FontSize="9.5"
                               Foreground="#A6ABB3"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
