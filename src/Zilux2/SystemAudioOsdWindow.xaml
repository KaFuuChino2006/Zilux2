<Window x:Class="Zilux2.SystemAudioOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zilux2 系统音频"
        Width="1040"
        Height="66"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- 留出 10px 透明边，阴影才不会被窗口边缘切成方角。
         屏幕上方居中，尺寸和播放条一致：收起 452×46，展开 1020×46，圆角 23 的整条胶囊。 -->
    <!-- 内容层固定成「最终宽度」并居中，胶囊（Shell）只对自己的宽度做补间；
         内容与 Shell 同级，按胶囊当前宽度裁切 —— 文字位置不动，
         只是随着胶囊长开被逐段揭开（这正是灵动岛那种展开感）。 -->
    <Grid Margin="10">
        <Grid x:Name="Stage"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Width="452"
              Height="46">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShellShift" />
            </Grid.RenderTransform>

            <Border x:Name="Shell"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="452"
                    Height="46"
                    CornerRadius="23"
                    Background="#F7F4EC"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    SizeChanged="OnShellSizeChanged" />
            <Grid x:Name="ContentLayer"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Width="452"
                  Height="46">
                <Grid x:Name="ContentRoot" Margin="18,0,18,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentShift" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 收起态：一颗小胶囊，只用一行讲清「在换设备」。 -->
                <StackPanel x:Name="PillRow"
                            Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="#3C66AA" VerticalAlignment="Center" />
                    <TextBlock x:Name="PillLabel"
                               Margin="8,0,0,0"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#7A7F88"
                               Text="系统音频"
                               VerticalAlignment="Center" />
                    <!-- 固定宽度：状态文字从「正在切换」变「已切换」、音量从 9% 变 100% 时，
                         整组不会重新居中，文字就不会左右跳。 -->
                    <TextBlock x:Name="PillStatus"
                               Margin="8,0,0,0"
                               Width="48"
                               TextAlignment="Center"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="#3C66AA"
                               Text="正在切换"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 后台切歌：封面块 + 歌名/歌手 + 状态，宽度按内容自适应。 -->
                <Grid x:Name="TrackRow"
                      Grid.Row="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TrackCover"
                            Width="30"
                            Height="30"
                            CornerRadius="9"
                            Background="#E7E1D2"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="TrackCoverImage"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed" />
                            <TextBlock x:Name="TrackCoverText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#5B5F68"
                                   Text="♪" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TrackTitle" TextTrimming="CharacterEllipsis"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#1B1D23"
                                   Text="—" />
                        <TextBlock x:Name="TrackArtist" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"
                                   FontSize="9.5"
                                   Foreground="#8A8F98"
                                   Text="—" />
                    </StackPanel>
                    <TextBlock x:Name="TrackStatus" Width="48" TextAlignment="Right"
                               Grid.Column="2"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="9.5"
                               FontWeight="Medium"
                               Foreground="#3C66AA"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Text="正在播放" />
                </Grid>

                <!-- 展开态：和播放条同宽的一行。固定成展开尺寸并居中，展开时只被逐段揭开，不重排。 -->
                <Grid x:Name="Detail"
                      Grid.Row="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="DetailShift" />
                    </Grid.RenderTransform>
                    <!-- 列全部 Auto：整条宽度由文字撑开，设备名再长也完整显示、不截断。 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="DeviceGlyph"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Stroke="#3C66AA"
                              StrokeThickness="1.25"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              VerticalAlignment="Center"
                              Data="M2,4.2 L4.6,4.2 L8.4,1.6 L8.4,10.4 L4.6,7.8 L2,7.8 Z" />
                        <TextBlock Margin="6,0,0,0"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="#7A7F88"
                                   Text="系统音频"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="FromStack" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="FromShift" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="FromCaption"
                                   Width="54"
                                   FontSize="8.5"
                                   Foreground="#8A8F98"
                                   Text="当前播放" />
                        <TextBlock x:Name="FromName" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#1B1D23"
                                   Text="—" />
                    </StackPanel>

                    <Canvas x:Name="ArrowCanvas"
                            Grid.Column="2"
                            Width="24"
                            Height="14"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center">
                        <Line x:Name="ArrowLine"
                              X1="1" Y1="7" X2="0" Y2="7"
                              Stroke="#3C66AA"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <Polygon x:Name="ArrowHead"
                                 Points="14,2 21,7 14,12"
                                 Fill="#3C66AA"
                                 Opacity="0" />
                    </Canvas>

                    <StackPanel x:Name="ToStack" Grid.Column="3" VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ToShift" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="ToCaption"
                                   Width="54"
                                   FontSize="8.5"
                                   Foreground="#8A8F98"
                                   Text="切换到" />
                        <TextBlock x:Name="ToName" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#3C66AA"
                                   Text="—" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="4"
                               Width="52"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               FontSize="9.5"
                               FontWeight="Medium"
                               Foreground="#3C66AA"
                               Text="正在切换" />
                </Grid>

                <!-- 进度条贴着下沿，和播放条一样细细一条。 -->
                <Border x:Name="ProgressTrack"
                        Grid.Row="0"
                        Height="2"
                        VerticalAlignment="Bottom"
                        Margin="16,0,16,5"
                        CornerRadius="1"
                        Background="#1F1B1D23">
                    <Border x:Name="ProgressFill"
                            Width="0"
                            HorizontalAlignment="Left"
                            CornerRadius="1"
                            Background="#3C66AA" />
                </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
